# Copy this file to .env and fill in real values.

# CORS - frontend origin(s), comma separated
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database connection.
# Local dev: SQLite is fine (relative to backend/).
# Production (Render): set this to your Render PostgreSQL "Internal
# Database URL" instead - SQLite on Render's web service filesystem is
# ephemeral and gets wiped on every redeploy, taking all accounts and
# history with it. See README/deployment notes for exact steps.
DATABASE_URL=sqlite:///./rexplore.db

# Max upload size in MB
MAX_UPLOAD_MB=50

# Sentence-Transformers model (downloaded on first run, needs internet)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional: Kaggle API credentials (https://www.kaggle.com/settings -> Create New API Token)
# Without these, Kaggle dataset search is skipped (not faked).
KAGGLE_USERNAME=
KAGGLE_KEY=

# Optional: path to tesseract binary if not on PATH (OCR fallback for scanned PDFs)
TESSERACT_CMD=

# HTTP timeout (seconds) for outbound calls to dataset repositories
EXTERNAL_API_TIMEOUT=12

# Authentication
# Generate a strong random value, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
